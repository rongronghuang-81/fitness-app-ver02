# ---------------------------------------------------------------------------
# Pole Studio — environment variables
# Copy to `.env.local` and fill in. Never commit `.env.local`.
# ---------------------------------------------------------------------------

# --- Public (safe to expose to the browser) --------------------------------
# Supabase Dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Dashboard → Project Settings → API → Project API keys → anon / public.
# This key is safe in the browser ONLY because Row Level Security is enabled on
# every table. Do not disable RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public base URL of the deployed app. Used to build password-reset links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server only (NEVER prefix these with NEXT_PUBLIC_) ---------------------
# Service-role key. Bypasses RLS completely. Used ONLY by the local demo-seed
# script (scripts/seed-demo.ts). It is NOT required to run the app, and must
# never be added to Vercel's client-exposed variables.
SUPABASE_SERVICE_ROLE_KEY=

# Used by the demo seed script to attach demo data to your instructor account.
SEED_INSTRUCTOR_EMAIL=instructor@example.com
SEED_INSTRUCTOR_PASSWORD=change-me-please

# --- Integration tests (optional) ------------------------------------------
# When unset, the integration/RLS test suite is skipped and only unit tests run.
TEST_SUPABASE_URL=
TEST_SUPABASE_ANON_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=
